+def _split_long_images(messages):
+    # DeepSeek rejects very tall JPEGs; preserve all pixels as ordered segments.
+    import base64, io
+    from PIL import Image
+    result = []
+    for message in messages:
+        message = dict(message)
+        content = message.get("content")
+        if isinstance(content, list):
+            parts = []
+            for part in content:
+                url = part.get("image_url", {}).get("url", "") if isinstance(part, dict) else ""
+                if url.startswith("data:image/jpeg;base64,"):
+                    image = Image.open(io.BytesIO(base64.b64decode(url.split(",", 1)[1])))
+                    if image.height > 2048:
+                        for y in range(0, image.height, 2048):
+                            segment = image.crop((0, y, image.width, min(y + 2048, image.height)))
+                            buf = io.BytesIO()
+                            segment.save(buf, format="JPEG", quality=95)
+                            img = dict(part["image_url"])
+                            img["url"] = "data:image/jpeg;base64," + base64.b64encode(buf.getvalue()).decode()
+                            parts.append({**part, "image_url": img})
+                        continue
+                parts.append(part)
+            message["content"] = parts
+        result.append(message)
+    return result
+
